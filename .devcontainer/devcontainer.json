{
  "name": "IAML — IA & ML pour la cybersécurité",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "postCreateCommand": "bash .devcontainer/postCreate.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers",
        "charliermarsh.ruff",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "jupyter.notebookFileRoot": "${workspaceFolder}",
        "notebook.output.textLineLimit": 60,
        "files.trimTrailingWhitespace": true,
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    },
    "codespaces": {
      "openFiles": ["README.md", "notebooks/enonces/01_donnees_soc.ipynb"]
    }
  },

  "forwardPorts": [8000, 8888],
  "portsAttributes": {
    "8000": { "label": "API de scoring (atelier 10)", "onAutoForward": "notify" },
    "8888": { "label": "JupyterLab", "onAutoForward": "silent" }
  },

  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },

  "remoteUser": "vscode"
}
